# =============================================================================
# LakeHouse Project - Single source of truth for all configuration.
# Copy this file to .env and fill in real values. Same keys, no real secrets.
# =============================================================================

# --- Shared identity (re-used across MinIO, Postgres, Trino, dbt, Airflow) ---
LAKEHOUSE_USER=changeme
LAKEHOUSE_PASSWORD=changeme

# --- MinIO / S3 object storage ---------------------------------------------
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=warehouse
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# --- LakeKeeper Postgres catalog DB -----------------------------------------
LK_POSTGRES_USER=changeme
LK_POSTGRES_PASSWORD=changeme
LK_POSTGRES_DB=lakekeeper_catalog
LK_ENCRYPTION_KEY=changeme

# --- Iceberg / LakeKeeper catalog -------------------------------------------
CATALOG_URI=http://lakekeeper:8181/catalog
CATALOG_WAREHOUSE=lakehouse_warehouse

# --- Trino query engine ------------------------------------------------------
TRINO_HOST_DOCKER=trino
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=staging

# --- Airflow -----------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=../../
_AIRFLOW_WWW_USER_USERNAME=changeme
_AIRFLOW_WWW_USER_PASSWORD=changeme
AIRFLOW_FERNET_KEY=changeme
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_JWT_SECRET=changeme
